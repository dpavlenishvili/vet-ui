{
  "name": "backend",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "backend/src",
  "prefix": "lib",
  "tags": [],
  "projectType": "library",
  "targets": {
    "generate": {
      "executor": "@vet/backend:sync",
      "options": {
        "openApiFilePath": "{projectRoot}/api-docs.json",
        "outputDir": "{projectRoot}/src/lib/generated"
      },
      "configurations": {
        "development": {
          "openApiFilePath": "https://develop-vet-back.dev01.dev.emis.ge/docs?api-docs.json"
        },
        "qwerty": {
          "openApiFilePath": "https://develop-vet-back.dev01.dev.emis.ge/docs?api-docs.json"
        },
        "production": {
          "openApiFilePath": "https://develop-vet-back.dev01.dev.emis.ge/docs?api-docs.json"
        }
      },
      "defaultConfiguration": "development"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "backend/jest.config.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
