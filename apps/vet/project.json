{
  "name": "vet",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/vet/src",
  "tags": ["type:app"],
  "targets": {
    "build": {
      "executor": "@angular-builders/custom-esbuild:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "{workspaceRoot}/dist/{projectRoot}",
        "index": "{projectRoot}/src/index.html",
        "browser": "{projectRoot}/src/main.ts",
        "server": "{projectRoot}/src/main.server.ts",
        "ssr": {
          "entry": "{projectRoot}/server.ts"
        },
        "plugins": [
          "{projectRoot}/setup-environment-plugin.mjs"
        ],
        "polyfills": ["zone.js", "@angular/localize/init"],
        "tsConfig": "{projectRoot}/tsconfig.app.json",
        "assets": ["{projectRoot}/src/favicon.ico", "{projectRoot}/src/assets"],
        "styles": ["{projectRoot}/src/styles.scss"],
        "scripts": [],
        "allowedCommonJsDependencies": ["dayjs"],
        "budgets": [
          {
            "type": "initial",
            "maximumWarning": "1mb",
            "maximumError": "3mb"
          },
          {
            "type": "anyComponentStyle",
            "maximumWarning": "50kb",
            "maximumError": "100kb"
          }
        ]
      },
      "configurations": {
        "production": {
          "outputHashing": "all"
        },
        "qwerty": {
          "fileReplacements": [
            {
              "replace": "apps/vet/src/environments/environment.ts",
              "with": "apps/vet/src/environments/environment.qwerty.ts"
            }
          ]
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "fileReplacements": [
            {
              "replace": "apps/vet/src/environments/environment.ts",
              "with": "apps/vet/src/environments/environment.development.ts"
            }
          ]
        },
        "local": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "fileReplacements": [
            {
              "replace": "apps/vet/src/environments/environment.ts",
              "with": "apps/vet/src/environments/environment.local.ts"
            }
          ]
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-builders/custom-esbuild:dev-server",
      "options": {
        "port": 4200,
        "proxyConfig": "apps/vet/proxy.config.json"
      },
      "configurations": {
        "production": {
          "buildTarget": "vet:build:production"
        },
        "development": {
          "buildTarget": "vet:build:development"
        },
        "qwerty": {
          "buildTarget": "vet:build:qwerty"
        },
        "local": {
          "buildTarget": "vet:build:local"
        }
      },
      "defaultConfiguration": "local"
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "{projectRoot}/jest.config.ts"
      }
    }
  }
}
